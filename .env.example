# Frontend public values. Supabase anon/publishable keys are intended for browser use;
# protect all application data with the RLS policies in supabase/migrations.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=

# Server-side only. Add your Groq API key to the local .env file.
# Do not prefix this key with VITE_; Vite would expose it to the browser.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
FRONTEND_ORIGIN=http://localhost:5173
